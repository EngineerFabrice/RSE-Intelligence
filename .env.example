SECRET_KEY=change-this-in-production
# Relative sqlite paths are resolved by Flask-SQLAlchemy relative to the instance/
# folder automatically, so this file lands at <project>/instance/rse_intelligence.db.
# Leave DATABASE_URL unset entirely to use the same default (see config.py).
DATABASE_URL=sqlite:///rse_intelligence.db
# Production example: mysql+pymysql://user:password@localhost:3306/rse_intelligence
UPLOAD_FOLDER=instance/uploads
MAX_CONTENT_LENGTH_MB=25
TESSERACT_CMD=
FLASK_ENV=development
# Optional: powers the "Ask RSE Market" assistant (Administrator/Analyst only). Leave
# all of these blank to leave the assistant disabled -- it reports itself as "not
# configured" rather than failing. Provider priority/failover:
#   Gemini (primary) -> Gemini (backup, optional) -> OpenAI (final fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Optional second Gemini configuration, used only if the primary fails. This must
# be a separately configured Gemini project/key -- NOT a second key in the same
# project, which would share the same quota and fail identically. Leave blank to
# skip the backup tier.
GEMINI_API_KEY_BACKUP=
GEMINI_MODEL_BACKUP=

# Optional final fallback provider if both Gemini tiers fail. Leave blank to skip.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
